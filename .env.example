# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string
DATABASE_URL=postgresql://poker:poker@localhost:5432/poker

# Session signing key — generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-random-32-plus-character-secret

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# ── Seed (first run only) ───────────────────────────────────────────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin1234

# ── Docker Compose (optional overrides) ───────────────────────────────────────
# APP_PORT=3001

# ── E2E tests (optional) ────────────────────────────────────────────────────
# PLAYWRIGHT_BASE_URL=http://localhost:3001
